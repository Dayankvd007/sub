# Copy to .env and fill in locally. .env is git-ignored — never commit real keys.
# This file lists variable NAMES only; it must never contain a real value.

# --- Provider credentials (read by the provider, never by the API layer) ---
OPENROUTER_API_KEY=
# Optional: only needed if you use --provider anthropic from the CLI.
ANTHROPIC_API_KEY=

# --- Phase 2a local API service ---
# Defaults shown; all are optional.

# Bind address. Keep 127.0.0.1 — this service holds provider credentials.
SUBTITLE_API_HOST=127.0.0.1
SUBTITLE_API_PORT=8000

# Phase 1 exit-gate selection. The CLI keeps its own separate defaults.
SUBTITLE_API_PROVIDER=openrouter
SUBTITLE_API_MODEL=google/gemini-3.1-flash-lite

# Comma-separated CORS allowlist. No wildcard is ever used.
# Load the unpacked extension in Chrome, copy its ID, then set:
#   ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=

# Request caps (bound worst-case cost and memory for one request).
MAX_CUES=5000
MAX_BODY_BYTES=5242880

# --- Phase 2b-1 persistence and cache ---

# SQLite database location. Defaults to a per-user data directory
# (~/.local/share/subtitle-translator/translations.db on Linux,
#  ~/Library/Application Support/... on macOS, %LOCALAPPDATA%\... on Windows).
# Never point this inside the repository.
SUBTITLE_DB_PATH=

# Set to false to bypass the cache and always call the provider.
SUBTITLE_CACHE_ENABLED=true

# Allow a client to override provider/model in the request body.
# Off by default: architecture §8 makes client-supplied values informational.
ALLOW_CLIENT_MODEL_OVERRIDE=false
